# Watchtower AI Environment Configuration

# Database Connection
DATABASE_URL=sqlite:///./watchtower.db

# --- Intelligent Root Cause Analysis Config ---

# AI Provider to use: 'openai', 'anthropic', or 'mock'
# If left blank, it will auto-detect based on available API keys.
LLM_PROVIDER=mock

# Model ID to target (e.g. gpt-4o-mini, claude-3-5-sonnet-20240620)
# Defaults:
# - OpenAI: gpt-4o-mini
# - Anthropic: claude-3-5-sonnet-20240620
AI_MODEL=

# OpenAI Configuration
OPENAI_API_KEY=

# Anthropic Configuration
ANTHROPIC_API_KEY=

# --- Server Configurations ---
HOST=127.0.0.1
PORT=8000
